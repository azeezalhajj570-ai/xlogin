# ---- Copy to .env and fill in. Never commit .env. ----

# Public hostname operators/subscribers reach (Caddy gets a TLS cert for it).
XLOGIN_DOMAIN=xlogin.example.com
XLOGIN_PUBLIC_BASE_URL=https://xlogin.example.com

# API keys your backend uses (Authorization: Bearer <key>). Comma-separated to
# support rotation. Each must be >=32 chars. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
XLOGIN_API_KEYS=replace-me-with-a-long-random-key

# Encryption keys for cookies/tokens at rest (Fernet). First key encrypts; all
# decrypt, so prepend a new one to rotate. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
XLOGIN_ENCRYPTION_KEYS=replace-me-with-a-fernet-key

# Image built from ./login-browser
XLOGIN_BROWSER_IMAGE=xlogin-browser:latest

# Concurrency and timeouts
XLOGIN_MAX_SESSIONS=1
XLOGIN_SESSION_TTL=900
XLOGIN_START_TIMEOUT=120

# Keep a per-account browser profile so returning users hit fewer 2FA/new-device
# prompts. Set 0 to make every login start from a clean browser.
XLOGIN_PERSIST_PROFILES=1

# ---- Persistent browsers ----------------------------------------------------
# Keep each account's Chrome open after login (refreshes cookies, detects sign-out).
XLOGIN_KEEP_ALIVE=1
XLOGIN_BROWSER_IDLE=0            # never sleep for idleness
XLOGIN_BROWSER_MEMORY=1g
XLOGIN_KEEPER_POLL=90            # seconds, jittered
XLOGIN_KEEPER_TOUCH=14400        # reload x.com/home about every 4 h, jittered
# XLOGIN_BROWSER_RESTART_MAX=5
# XLOGIN_MOBILE_SCREEN=520x900x24
# XLOGIN_DESKTOP_SCREEN=1440x900x24
# Mobile logins use a mobile Chrome user-agent so x.com serves its real mobile
# site (a desktop UA in a phone-sized window renders broken and gets the login
# "temporarily limited"). Leave empty to auto-build one matching the installed
# Chrome version; set it to pin an exact UA. Desktop logins keep Chrome's native UA.
# XLOGIN_MOBILE_USER_AGENT=

# Requires Docker CE (not the snap package).
XLOGIN_NO_NEW_PRIVILEGES=1

# ---- Browser nodes (slots: 1 slot = 1 Chrome, logins included) --------------
# One server, 1 vCPU / 4 GB, 2 accounts:
XLOGIN_NODES=b1
XLOGIN_NODE_B1_DOCKER=tcp://dockerproxy:2375
XLOGIN_NODE_B1_SLOTS=2
# A second browser server reached over WireGuard:
# XLOGIN_NODES=b1,b2
# XLOGIN_NODE_B2_DOCKER=tcp://10.8.0.12:2375
# XLOGIN_NODE_B2_ADDRESS=10.8.0.12
# XLOGIN_NODE_B2_SLOTS=6
# XLOGIN_NODE_B2_CALLBACK_BASE_URL=http://10.8.0.10:8000

# Optional: notify your backend of login.started/succeeded/failed/timeout/cancelled.
# Payloads are HMAC-signed; cookies are NEVER in the payload (fetch them via the
# credentials endpoint on success).
# XLOGIN_WEBHOOK_URL=https://api.example.com/internal/xlogin/webhook
# XLOGIN_WEBHOOK_SECRET=replace-me-with-a-long-random-secret

# Local/dev only: allow plain http for PUBLIC_BASE_URL (never in production).
# XLOGIN_ALLOW_INSECURE_HTTP=0
